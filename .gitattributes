# The embedded skill must be the same bytes on every OS (a CRLF checkout
# would change what Rex installs and what its tests read).
internal/skill/rex-plan/SKILL.md text eol=lf
# Plans too: the tests edit the CUJ fixture across lines, byte for byte.
*.rex.json text eol=lf
# Shell scripts run under bash, which reads a CRLF line as a syntax error.
*.sh text eol=lf
# The generated OpenCode plugin's golden: the same bytes on every OS.
internal/watch/testdata/*.js text eol=lf
